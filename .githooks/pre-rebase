#!/usr/bin/env bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

primary="$(scripts/detect-primary-branch.sh)"
if [[ -n "${2:-}" ]]; then
    target_ref="$(git rev-parse --symbolic-full-name "$2")"
else
    target_ref="$(git symbolic-ref --quiet HEAD || true)"
fi

if [[ "$target_ref" == "refs/heads/$primary" ]]; then
    printf 'Rebasing primary is not allowed: %s; preserve merge history.\n' \
        "$primary" >&2
    exit 1
fi
